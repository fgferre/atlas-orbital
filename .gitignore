# Legacy/reference files (not needed in version control)
_legacy/

# Gaia Sky reference assets (license-ambiguous — for local derivative-work
# generation only, see references/gaia-sky-source/README.md). The
# regenerated CC-BY-4.0 replacements go to public/textures/lens/, which
# IS committed after T2.3b. See ROADMAP.md §T2.3.
references/

# T2.3a placeholder lens sprites — copied from references/gaia-sky-source/
# into public/textures/lens/ for local calibration. License-ambiguous
# Gaia originals; MUST NOT be committed. Removed by T2.3b when user drops
# CC-BY-4.0 replacements and we track them in git.
public/textures/lens/*.png
public/textures/lens/*.jpg

# Same pattern as the lens sprites above — placeholder star-tex-03 sprite
# copied from references/gaia-sky-source/ into public/textures/stars/ for
# LightGlow calibration (kills the cross-spike artifact that the
# procedural-gaussian substitute produced — see d6165c6 + the
# Ressl/Hammerschmid credit in references/gaia-sky-source/star-tex-01-credit.txt).
# License-ambiguous; MUST NOT be committed.
public/textures/stars/*.png
public/textures/stars/*.jpg

# Build-time download cache (large source CSVs regenerated by npm scripts)
scripts/.cache/

# External harness/tooling workspaces kept outside Atlas scope
oh-my-openagent-dual-oracle/
.sisyphus/
.opencode/
src/hooks/dual-oracle-loop/
